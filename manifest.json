{
  "manifest_version": 3,
  "name": "NovaCast",
  "description": "NovaCast captures your tab, window, or screen as a video.",
  "version": "2.0.0",
  "permissions": [
    "desktopCapture",
    "storage"
  ],
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "NovaCast",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
